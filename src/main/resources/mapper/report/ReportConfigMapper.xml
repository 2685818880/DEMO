<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zdjc.wms.project.report.mapper.ReportConfigMapper">
    <select id="selectByCode" resultType="cn.zdjc.wms.project.report.model.entity.ReportConfigEntity">
        SELECT * FROM wms_report_config WHERE report_code = #{reportCode} LIMIT 1
    </select>
    <select id="checkCodeExists" resultType="int">
        SELECT COUNT(*) FROM wms_report_config WHERE report_code = #{reportCode}
    </select>
</mapper>
