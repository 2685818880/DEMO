<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zdjc.wms.project.ai.mapper.AiProviderMapper">
    <select id="selectByKeyStatus" resultType="cn.zdjc.wms.project.ai.model.entity.AiProviderEntity">
        SELECT * FROM wms_ai_provider
        WHERE is_active = 1 AND api_key_status = #{status}
        ORDER BY create_datetime DESC
    </select>
</mapper>
